<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/sw_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />

    <Chronometer
        android:id="@+id/sw_timer"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />
  </LinearLayout>

  <TextView
      android:id="@+id/sw_subtitle"
      style="@style/TextAppearance.Compat.Notification"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1" />

  <LinearLayout
      android:id="@+id/sw_values"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/sw_reps"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/session_widget_chip"
        android:gravity="center"
        android:maxLines="1" />

    <TextView
        android:id="@+id/sw_weight"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/session_widget_chip"
        android:gravity="center"
        android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/sw_prev"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/session_widget_chip"
        android:gravity="center"
        android:text="@string/session_widget_prev_label" />

    <TextView
        android:id="@+id/sw_done"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1.3"
        android:background="@drawable/session_widget_done"
        android:gravity="center"
        android:text="@string/session_widget_done_label"
        android:textColor="#0C0D10"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sw_next"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/session_widget_chip"
        android:gravity="center"
        android:text="@string/session_widget_next_label" />
  </LinearLayout>
</LinearLayout>
